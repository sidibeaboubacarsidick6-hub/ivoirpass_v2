+@seller_required
+def product_stats(request, slug):
+    """
+    Statistiques détaillées d'un produit — même esprit que les statistiques
+    d'un événement côté billetterie (apps/dashboard/views.py:event_stats) :
+    KPIs financiers, répartition par format, courbe des ventes, commandes
+    récentes.
+
+    Portée : commandes invité uniquement (GuestProductOrder), seul canal
+    de vente boutique réellement actif (voir audit — le tunnel "avec
+    compte" ProductOrder est désactivé côté site).
+    """
+    from django.db.models import Sum
+    from django.db.models.functions import TruncDate
+    from datetime import timedelta
+
+    product = get_object_or_404(Product, slug=slug, seller=request.user)
+
+    paid_orders = GuestProductOrder.objects.filter(
+        product=product, status=GuestProductOrder.Status.PAID
+    )
+
+    units_sold = paid_orders.aggregate(t=Sum('quantity'))['t'] or 0
+    gross_revenue = paid_orders.aggregate(t=Sum('subtotal'))['t'] or 0
+    commission_rate = float(product.commission_rate) / 100
+    net_revenue = int(round(float(gross_revenue) * (1 - commission_rate)))
+    commission = int(gross_revenue) - net_revenue
+    orders_count = paid_orders.count()
+
+    downloads_agg = GuestDownloadLink.objects.filter(product=product).aggregate(
+        used=Sum('download_count'), total=Sum('max_downloads')
+    )
+    downloads_used = downloads_agg['used'] or 0
+    downloads_total = downloads_agg['total'] or 0
+
+    # Répartition par format (téléchargement / livraison)
+    format_stats = []
+    for value, label in GuestProductOrder.DeliveryMethod.choices:
+        qs = paid_orders.filter(delivery_method=value)
+        count = qs.count()
+        if count:
+            format_stats.append({
+                'label': label,
+                'count': count,
+                'revenue': qs.aggregate(t=Sum('subtotal'))['t'] or 0,
+            })
+
+    # Courbe des ventes — 30 derniers jours
+    since = timezone.now() - timedelta(days=30)
+    timeline_qs = (
+        paid_orders.filter(paid_at__gte=since)
+        .annotate(day=TruncDate('paid_at'))
+        .values('day')
+        .annotate(qty=Sum('quantity'))
+        .order_by('day')
+    )
+    sales_timeline = [
+        {'date': t['day'].strftime('%d/%m'), 'qty': t['qty']}
+        for t in timeline_qs if t['day']
+    ]
+
+    recent_orders = paid_orders.order_by('-paid_at')[:20]
+
+    return render(request, 'store/product_stats.html', {
+        'product': product,
+        'units_sold': units_sold,
+        'gross_revenue': gross_revenue,
+        'net_revenue': net_revenue,
+        'commission': commission,
+        'orders_count': orders_count,
+        'downloads_used': downloads_used,
+        'downloads_total': downloads_total,
+        'format_stats': format_stats,
+        'sales_timeline': sales_timeline,
+        'recent_orders': recent_orders,
+    })
+
+
+@seller_required
+def product_buyers(request, slug):
+    """
+    Liste complète des acheteurs d'un produit — recherche/filtrage
+    combinables, export CSV et impression. Même patron que la liste des
+    participants d'un événement (apps/dashboard/views.py:participants).
+    """
+    product = get_object_or_404(Product, slug=slug, seller=request.user)
+
+    orders = GuestProductOrder.objects.filter(
+        product=product, status=GuestProductOrder.Status.PAID
+    ).order_by('-paid_at')
+
+    search = request.GET.get('q', '').strip()
+    delivery_filter = request.GET.get('delivery', '').strip()
+
+    if search:
+        orders = orders.filter(
+            Q(first_name__icontains=search) | Q(last_name__icontains=search) |
+            Q(email__icontains=search) | Q(phone__icontains=search) |
+            Q(order_number__icontains=search)
+        )
+
+    if delivery_filter:
+        orders = orders.filter(delivery_method=delivery_filter)
+
+    return render(request, 'store/product_buyers.html', {
+        'product': product,
+        'orders': orders,
+        'search': search,
+        'delivery_filter': delivery_filter,
+        'total_count': orders.count(),
+    })
+
+
+@seller_required
+def export_product_buyers_csv(request, slug):
+    """Exporte la liste complète des acheteurs d'un produit en CSV."""
+    import csv
+
+    product = get_object_or_404(Product, slug=slug, seller=request.user)
+    orders = GuestProductOrder.objects.filter(
+        product=product, status=GuestProductOrder.Status.PAID
+    ).order_by('-paid_at')
+
+    response = HttpResponse(content_type='text/csv')
+    response['Content-Disposition'] = f'attachment; filename="acheteurs_{product.slug}.csv"'
+    response.write('\ufeff')
+    writer = csv.writer(response)
+    writer.writerow(['Commande', 'Nom', 'Email', 'Téléphone', 'Format', 'Qté', 'Montant', 'Date'])
+    for order in orders:
+        writer.writerow([
+            order.order_number, order.buyer_name, order.email, order.phone,
+            order.get_delivery_method_display(), order.quantity,
+            int(order.total), order.paid_at.strftime('%d/%m/%Y %H:%M') if order.paid_at else '',
+        ])
+
+    log_action(
+        action=AuditLog.Action.EXPORT,
+        description=f"Export CSV des acheteurs — {product.name}",
+        user=request.user, model_name='GuestProductOrder',
+        metadata={'product': product.name, 'count': orders.count()},
+        ip_address=get_client_ip(request),
+    )
+    return response
+
+
